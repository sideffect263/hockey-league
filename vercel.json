{
  "functions": {
    "api/game-form.js": { "includeFiles": "public/logos/main-logo.png" }
  },
  "headers": [
    {
      "source": "/rinkhockeyIL.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"rinkhockeyIL.apk\"" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/media",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },

    { "source": "/games/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/tv", "destination": "/api/resolve?type=games&id=:id&suffix=tv" },
    { "source": "/players/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "destination": "/api/resolve?type=players&id=:id" },
    { "source": "/teams/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "destination": "/api/resolve?type=teams&id=:id" },
    { "source": "/games/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "destination": "/api/resolve?type=games&id=:id" },
    { "source": "/tournaments/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "destination": "/api/resolve?type=tournaments&id=:id" },

    {
      "source": "/players/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=players&id=:id"
    },
    {
      "source": "/teams/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=teams&id=:id"
    },
    {
      "source": "/games/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=games&id=:id"
    },
    {
      "source": "/tournaments/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=tournaments&id=:id"
    },
    {
      "source": "/posts/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=posts&id=:id"
    },

    { "source": "/players/:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?type=players&id=:id" },
    { "source": "/teams/:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?type=teams&id=:id" },
    { "source": "/games/:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?type=games&id=:id" },
    { "source": "/tournaments/:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?type=tournaments&id=:id" },
    { "source": "/posts/:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?type=posts&id=:id" },
    { "source": "/", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=home" },
    { "source": "/standings", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=standings" },
    { "source": "/teams", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=teams" },
    { "source": "/players", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=players" },
    { "source": "/games", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=games" },
    { "source": "/statistics", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=statistics" },
    { "source": "/tournaments", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=tournaments" },
    { "source": "/archive/:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?type=archive&id=:id" },
    { "source": "/archive", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=archive" },
    { "source": "/guide", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=guide" },
    { "source": "/app", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=app" },
    { "source": "/privacy", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot).*" }], "destination": "/api/seo?page=privacy" },

    { "source": "/((?!assets/).*)", "destination": "/" }
  ]
}
